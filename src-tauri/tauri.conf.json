{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lectern",
  "mainBinaryName": "lectern",
  "version": "0.1.0",
  "identifier": "dev.lectern.viewer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lectern",
        "width": 1100,
        "height": 800,
        "minWidth": 420,
        "minHeight": 300,
        "visible": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' mdfile: http://mdfile.localhost https: http: data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Read-only Markdown viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "name": "Markdown",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
